{
  "name": "outboxrelay",
  "version": "1.0.0",
  "description": "Transactional outbox relay with row leasing, retries with backoff and a dead-letter queue",
  "private": true,
  "type": "module",
  "author": "Taaniel Vananurm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taan1el/outboxrelay.git"
  },
  "homepage": "https://taan1el.github.io/outboxrelay/",
  "bugs": {
    "url": "https://github.com/Taan1el/outboxrelay/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "npm run lint --workspace=server",
    "lint:client": "npm run lint --workspace=client",
    "build:pages": "npm run build:pages --workspace=client"
  },
  "keywords": [
    "transactional-outbox",
    "event-driven-architecture",
    "message-relay",
    "dead-letter-queue",
    "sqlite",
    "row-leasing",
    "idempotent-consumer",
    "react"
  ]
}
