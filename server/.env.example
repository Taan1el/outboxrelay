# Copy to .env and adjust. The server reads these from the process environment and does not
# load this file itself, so export the values or start Node with --env-file, for example:
#   node --env-file=server/.env server/dist/server/src/index.js

# Port the Express server listens on.
PORT=4003

# SQLite database file. Default: data/outbox.db at the repository root.
OUTBOXRELAY_DB_PATH=

# Milliseconds between automatic relay cycles (minimum 100). Default: 2500.
POLL_INTERVAL_MS=2500
